# Solana RPC endpoint (default: mainnet-beta public RPC)
# For production, use a dedicated RPC provider like:
# - Helius: https://rpc.helius.xyz/?api-key=YOUR_KEY
# - Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# - QuickNode: https://YOUR_ENDPOINT.solana-mainnet.quiknode.pro/YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Cache settings (seconds)
CACHE_TTL=300

# Optional: CoinGecko API key for better pricing data
# COINGECKO_API_KEY=your_key_here
